{
  "name": "visionflow-inspection",
  "version": "2.0.0",
  "description": "视界智检 V2.0 - 面向工业现场的 AI 视觉检测平台，连接工业相机与 PLC，提供多相机实时推理、模型训练测试、质量追溯和 Windows/Web 部署。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "web:dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "web:preview": "vite preview --host 0.0.0.0 --port 5173",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build && npm run tauri:prepare && tauri build",
    "tauri:prepare": "node scripts/prepare-tauri-sidecar.mjs"
  },
  "author": {
    "name": "VisionFlow Inspection",
    "email": "dev@vision-system.local"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.4",
    "@tauri-apps/plugin-dialog": "^2.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
