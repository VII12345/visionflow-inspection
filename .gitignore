/model_classifier.pth
/model_classifier_test.pth

# Bundled LECPServer copy (dev staging copy, ~530M; build script copies to view/resources)
/resources/lecpserver/
/view/resources/lecpserver/

# Training outputs at root
/training_history.json

# Runtime data
data/captures/
data/*.log

# Environment / secrets
.env
.env.local
.env.*.local

# Python packaging
*.egg-info/
*.egg
*.whl

# OS generated files
.DS_Store
Thumbs.db

